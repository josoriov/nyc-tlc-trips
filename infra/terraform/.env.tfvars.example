# Safe input file for scripts/tf-safe.sh.
# Only TF_VAR_* keys are accepted by the wrapper.

TF_VAR_project_id=your-gcp-project-id
TF_VAR_github_owner=your-github-owner
TF_VAR_github_repo=nyc-tlc-trips

TF_VAR_bigquery_location=US
TF_VAR_dev_dataset_id=taxi_dbt_dev
TF_VAR_prod_dataset_id=taxi_dbt_prod
TF_VAR_ci_service_account_id=github-dbt-ci
TF_VAR_wif_pool_id=github-pool
TF_VAR_wif_provider_id=github-provider
